# Optional server-side AI. Never prefix secrets with VITE_.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Mock login: accounts are kept in data/accounts.json (no database, Firebase, or Meta setup).
